# Copiez ce fichier vers `.env.production` et stockez les secrets hors Git.
# Aucun tag `latest` n'est accepté par les scripts de release.
VIDIOAI_VERSION=2026.08.13-1
VIDIOAI_REGISTRY=rg.fr-par.scw.cloud/vidioai
VIDIOAI_HTTP_PORT=8080
VIDIOAI_STATE_DIR=/var/lib/vidioai/state
# Le registre ModelPack versionné persiste sous
# $VIDIOAI_STATE_DIR/model-pack-registry (backend RW, worker RO).
VIDIOAI_SCRATCH_DIR=/scratch/vidioai
VIDIOAI_OUTPUTS_DIR=/var/lib/vidioai/outputs
VIDIOAI_WORKER_TOKEN=replace-with-at-least-32-random-characters
VIDIOAI_ADMIN_TOKEN=replace-with-at-least-32-random-characters
HOST_AGENT_URL=http://host.docker.internal:8091
HOST_AGENT_TOKEN=replace-with-at-least-32-random-characters
VIDIOAI_S3_ENABLED=true
VIDIOAI_AUTO_CACHE_MODELS=false

# Moteur ComfyUI interne optionnel. Laisser COMPOSE_PROFILES vide conserve le
# déploiement Diffusers actuel; `COMPOSE_PROFILES=comfyui` active ce service.
COMPOSE_PROFILES=
COMFYUI_URL=http://comfyui:8188
VIDIOAI_COMFYUI_IMAGE=ghcr.io/lecode-official/comfyui-docker@sha256:e27739fc19d577d694ea99846a6c602e06dac963bebb2f056e22d97d19c392dd

# Hugging Face : nécessaire seulement pour les dépôts gated/private.
HF_TOKEN=
HF_ENDPOINT=https://huggingface.co
HF_CATALOG_TTL_SECONDS=900

# API S3-compatible Scaleway.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=fr-par
AWS_ENDPOINT_URL_S3=https://s3.fr-par.scw.cloud
AWS_S3_BUCKET=
AWS_S3_STORAGE_CLASS=ONEZONE_IA

RUST_LOG=info
